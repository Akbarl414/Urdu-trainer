{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "unit.schema.json",
  "title": "Unit",
  "type": "object",
  "required": [
    "id",
    "order",
    "title",
    "cefr",
    "can_do"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/unitId"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "Equals the number in the id (unit-01 → 1)."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "cefr": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B1+",
        "B2"
      ]
    },
    "can_do": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retired": {
      "type": "boolean"
    }
  }
}
