{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "required": [
    "id",
    "unit",
    "order",
    "title",
    "can_do",
    "context",
    "grammar",
    "new_vocab",
    "exercises",
    "dialogue"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/lessonId"
    },
    "unit": {
      "$ref": "common.schema.json#/definitions/unitId"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "GLOBAL position; equals the number in the id (lesson-011 → 11)."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "can_do": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: \"You can say what you ate yesterday\"."
    },
    "context": {
      "type": "string",
      "enum": [
        "family",
        "media",
        "uk-life"
      ]
    },
    "review": {
      "type": "boolean",
      "description": "True for the unit's review lesson."
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gender",
          "oblique",
          "agreement",
          "perfective",
          "ne"
        ]
      },
      "uniqueItems": true,
      "description": "Grammar features switched on when this lesson is completed (CURRICULUM.md, 'Grammar features'). Add a feature here before using it."
    },
    "grammar": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "heading": {
            "$ref": "common.schema.json#/definitions/prose"
          },
          "body": {
            "$ref": "common.schema.json#/definitions/prose"
          },
          "table": {
            "type": "object",
            "required": [
              "headers",
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "headers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "common.schema.json#/definitions/triple"
                      }
                    ]
                  }
                }
              }
            }
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "$ref": "common.schema.json#/definitions/triple"
            },
            "description": "Example sentences for this screen, shown with audio and the script toggle."
          }
        }
      },
      "description": "2–4 short screens (BRIEF §5.2), each fitting a phone screen."
    },
    "new_vocab": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "common.schema.json#/definitions/kebabId"
      },
      "uniqueItems": true
    },
    "exercises": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "fill-blank",
              "multiple-choice",
              "choose-form",
              "reorder",
              "error-spot",
              "translate",
              "transform",
              "listen"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fill-blank"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/fill-blank"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "multiple-choice"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/multiple-choice"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "choose-form"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/choose-form"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "reorder"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/reorder"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "error-spot"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/error-spot"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "translate"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/translate"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "transform"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/transform"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "listen"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/listen"
            }
          }
        ]
      }
    },
    "dialogue": {
      "type": "object",
      "required": [
        "setting",
        "speakers",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "setting": {
          "$ref": "common.schema.json#/definitions/prose",
          "description": "One or two English sentences setting the scene, shown before the first line."
        },
        "speakers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/definitions/kebabId"
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "description": "Label shown in the app, e.g. \"Sara's mum\" or \"You\"."
              },
              "gender": {
                "type": "string",
                "enum": [
                  "m",
                  "f"
                ],
                "description": "Required for every speaker except the learner: Urdu verbs and adjectives agree with the speaker."
              },
              "learner": {
                "type": "boolean",
                "description": "The learner's own role (at most one). Its gender comes from settings.learnerGender. Lines a woman would say differently carry learner_f (D23)."
              }
            }
          }
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "speaker",
              "roman",
              "ur",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "speaker": {
                "$ref": "common.schema.json#/definitions/kebabId",
                "description": "A speakers[].id."
              },
              "roman": {
                "type": "string",
                "minLength": 1
              },
              "ur": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "audio": {
                "$ref": "common.schema.json#/definitions/audioPath"
              },
              "check": {
                "type": "object",
                "required": [
                  "question",
                  "options",
                  "answerIndex"
                ],
                "additionalProperties": false,
                "properties": {
                  "question": {
                    "$ref": "common.schema.json#/definitions/prose"
                  },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 4,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "answerIndex": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "description": "Other speakers' lines (required): a comprehension question answered after hearing the line, before its text appears. English options; the app shuffles them."
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "$ref": "common.schema.json#/definitions/triple"
                },
                "description": "Learner lines only: wrong answers. With options the learner picks the line; without them the learner builds it from tiles. The English of each stays hidden until answered, so it can say why the option is wrong."
              },
              "learner_f": {
                "type": "object",
                "required": [
                  "roman",
                  "ur"
                ],
                "additionalProperties": false,
                "properties": {
                  "roman": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ur": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "$ref": "common.schema.json#/definitions/triple"
                    },
                    "description": "The woman's wrong options, when they differ from the base ones."
                  },
                  "audio": {
                    "$ref": "common.schema.json#/definitions/audioPath"
                  }
                },
                "description": "Learner lines only: the woman's version of this line (base fields are the man's). en only if the English differs."
              }
            }
          }
        }
      }
    },
    "game_items": {
      "type": "array",
      "description": "Optional authored items for games (e.g. \"Ne or no ne?\", from Unit 12). Tightened in Phase 4.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/kebabId"
          },
          "type": {
            "type": "string",
            "enum": [
              "ne"
            ]
          },
          "sentence": {
            "$ref": "common.schema.json#/definitions/triple"
          }
        }
      }
    },
    "retired": {
      "type": "boolean"
    }
  }
}
