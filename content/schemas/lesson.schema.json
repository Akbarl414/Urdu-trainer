{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "required": [
    "id",
    "unit",
    "order",
    "title",
    "can_do",
    "context",
    "grammar",
    "new_vocab",
    "exercises",
    "dialogue"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/lessonId"
    },
    "unit": {
      "$ref": "common.schema.json#/definitions/unitId"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "GLOBAL position; equals the number in the id (lesson-011 → 11)."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "can_do": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: \"You can say what you ate yesterday\"."
    },
    "context": {
      "type": "string",
      "enum": [
        "family",
        "media",
        "uk-life"
      ]
    },
    "review": {
      "type": "boolean",
      "description": "True for the unit's review lesson."
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z-]*$"
      },
      "uniqueItems": true,
      "description": "Grammar features switched on when this lesson is completed (gender, oblique, agreement, perfective, ne)."
    },
    "grammar": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "heading": {
            "$ref": "common.schema.json#/definitions/prose"
          },
          "body": {
            "$ref": "common.schema.json#/definitions/prose"
          },
          "table": {
            "type": "object",
            "required": [
              "headers",
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "headers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "common.schema.json#/definitions/triple"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "new_vocab": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "common.schema.json#/definitions/kebabId"
      },
      "uniqueItems": true
    },
    "exercises": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "fill-blank",
              "multiple-choice",
              "choose-form",
              "reorder",
              "error-spot",
              "translate",
              "transform",
              "listen"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fill-blank"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/fill-blank"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "multiple-choice"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/multiple-choice"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "choose-form"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/choose-form"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "reorder"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/reorder"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "error-spot"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/error-spot"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "translate"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/translate"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "transform"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/transform"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "listen"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "exercise.schema.json#/definitions/listen"
            }
          }
        ]
      }
    },
    "dialogue": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "speaker",
          "roman",
          "ur",
          "en"
        ],
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "type": "string",
            "minLength": 1,
            "description": "Lowercase roman name, e.g. ahmad."
          },
          "roman": {
            "type": "string",
            "minLength": 1
          },
          "ur": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "$ref": "common.schema.json#/definitions/audioPath"
          }
        }
      }
    },
    "game_items": {
      "type": "array",
      "description": "Optional authored items for games (e.g. \"Ne or no ne?\", from Unit 12). Tightened in Phase 4.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/definitions/kebabId"
          },
          "type": {
            "type": "string",
            "enum": [
              "ne"
            ]
          },
          "sentence": {
            "$ref": "common.schema.json#/definitions/triple"
          }
        }
      }
    },
    "retired": {
      "type": "boolean"
    }
  }
}
